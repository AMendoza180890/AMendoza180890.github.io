---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pathWithoutLocale = Astro.url.pathname.replace(/^\/(en|es)/, '') || '/';
const enHref = `/en${pathWithoutLocale === '/' ? '/' : pathWithoutLocale}`;
const esHref = `/es${pathWithoutLocale === '/' ? '/' : pathWithoutLocale}`;
---

<div class="lang-switch" role="group" aria-label={t(locale, 'lang.switch')}>
  <a href={enHref} aria-current={locale === 'en' ? 'true' : undefined} hreflang="en" lang="en">EN</a>
  <a href={esHref} aria-current={locale === 'es' ? 'true' : undefined} hreflang="es" lang="es">ES</a>
</div>
