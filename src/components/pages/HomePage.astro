---
import type { Locale } from '../../i18n/ui';
import { t } from '../../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { site, skills } from '../../i18n/content';
import SocialLinks from '../SocialLinks.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="hero" id="top">
  <div class="hero-media" aria-hidden="true">
    <img
      src="/img/portfolio/background-mobile.webp"
      srcset="/img/portfolio/background-mobile.webp 480w, /img/portfolio/background-tablet.webp 1024w, /img/portfolio/background.webp 1920w"
      sizes="100vw"
      alt=""
      width="480"
      height="360"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="container">
    <div class="hero-inner">
      <p class="eyebrow">{t(locale, 'hero.eyebrow')}</p>
      <h1>{site.name}</h1>
      <span class="hero-role">
        {t(locale, 'hero.imA')}
        <span class="typed" data-typed-items={t(locale, 'hero.typed')}></span>
      </span>

      <div class="hero-actions">
        <a class="btn btn-primary" href={getRelativeLocaleUrl(locale, 'projects')}>
          {t(locale, 'hero.ctaProjects')}
        </a>
        <a class="btn btn-ghost" href={`mailto:${site.email}`}>
          {t(locale, 'hero.ctaContact')}
        </a>
        <SocialLinks label="Social" />
      </div>
    </div>
  </div>
</section>

<section class="section container" id="about">
  <div class="about-grid">
    <div>
      <p class="eyebrow">{t(locale, 'about.eyebrow')}</p>
      <h2>{t(locale, 'about.title')}</h2>
    </div>
    <div class="about-body">
      <p>{t(locale, 'about.body')}</p>
    </div>
  </div>
</section>

<section class="section--tight container" id="skills">
  <div class="section-head">
    <p class="eyebrow">{t(locale, 'skills.eyebrow')}</p>
    <h2>{t(locale, 'skills.title')}</h2>
  </div>

  <ul class="grid grid--2 grid--3">
    {skills[locale].map((item) => (
      <li class="card skill-card">
        <h3>{item.label}</h3>
        <p>{item.value}</p>
      </li>
    ))}
  </ul>
</section>
