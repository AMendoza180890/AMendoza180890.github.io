---
import type { Locale } from '../../i18n/ui';
import { t } from '../../i18n/ui';
import { projects } from '../../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="section container" id="top">
  <header class="section-head">
    <p class="eyebrow">{t(locale, 'projects.eyebrow')}</p>
    <h1>{t(locale, 'projects.heading')}</h1>
    <p class="lead">{t(locale, 'projects.intro')}</p>
  </header>

  <div class="project-grid">
    {projects[locale].map((project) => {
      const Tag = project.url ? 'a' : 'article';
      const linkProps = project.url
        ? {
            href: project.url,
            rel: 'noopener noreferrer',
            target: '_blank',
            'aria-label': `${project.title} — ${t(locale, 'projects.visit')}`,
          }
        : {};

      return (
        <Tag class="project-card" {...linkProps}>
          <div class="project-thumb">
            {project.image ? (
              <img
                src={project.image}
                alt={project.imageAlt}
                width="800"
                height="500"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="project-placeholder" aria-hidden="true">
                <span>{project.title.split('—')[0].trim()}</span>
              </div>
            )}
          </div>
          <div class="project-body">
            <h2 class="project-title">
              {project.title}
              {project.url && (
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              )}
            </h2>
            <p>{project.description}</p>
            <ul class="chip-list">
              {project.stack.map((tech) => (
                <li class="chip">{tech}</li>
              ))}
            </ul>
          </div>
        </Tag>
      );
    })}
  </div>
</section>
