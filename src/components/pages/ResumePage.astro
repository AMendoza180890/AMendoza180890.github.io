---
import type { Locale } from '../../i18n/ui';
import { t } from '../../i18n/ui';
import { site, experience, getResumePdf } from '../../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const resumePdf = getResumePdf(locale);
---

<section class="section container" id="top">
  <header class="section-head">
    <p class="eyebrow">{t(locale, 'resume.eyebrow')}</p>
    <h1>{t(locale, 'resume.pageTitle')}</h1>
    <p class="lead">{t(locale, 'resume.summaryBody')}</p>
  </header>

  <div class="resume-columns">
    <article class="card">
      <h2 class="timeline-role">{t(locale, 'resume.summary')}</h2>
      <p class="timeline-place">{site.name}</p>
      <ul class="info-list">
        <li><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>{t(locale, 'resume.languagesBody')}</li>
      </ul>
    </article>

    <article class="card">
      <h2 class="timeline-role">{t(locale, 'resume.education')}</h2>
      <p class="timeline-place">{t(locale, 'resume.degree')}</p>
      <ul class="info-list">
        <li>{t(locale, 'resume.university')}</li>
        <li>{t(locale, 'resume.certifications')}</li>
      </ul>
    </article>
  </div>

  <div class="section--tight">
    <div class="section-head">
      <h2>{t(locale, 'resume.experience')}</h2>
    </div>

    <div class="timeline">
      {experience[locale].map((job) => (
        <article class="timeline-item">
          <div class="timeline-head">
            <h3 class="timeline-role">{job.role}</h3>
            <span class="timeline-period">{job.period}</span>
          </div>
          <p class="timeline-place">
            {job.companyUrl ? (
              <a href={job.companyUrl} rel="noopener noreferrer" target="_blank">{job.company}</a>
            ) : (
              job.company
            )}
            <span aria-hidden="true"> · </span>{job.place}
          </p>
          {job.note && <p class="timeline-note">{job.note}</p>}
          {job.bullets && job.bullets.length > 0 && (
            <ul class="bullet-list">
              {job.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}
          {job.engagements && job.engagements.length > 0 && (
            <div class="engagements">
              {job.engagements.map((engagement) => (
                <div class="engagement">
                  <div class="engagement-head">
                    <h4 class="engagement-title">
                      {engagement.url ? (
                        <a href={engagement.url} rel="noopener noreferrer" target="_blank">
                          {engagement.name}
                        </a>
                      ) : (
                        engagement.name
                      )}
                    </h4>
                    {engagement.period && (
                      <span class="timeline-period">{engagement.period}</span>
                    )}
                  </div>
                  {engagement.stack && (
                    <p class="engagement-stack">{engagement.stack}</p>
                  )}
                  <ul class="bullet-list">
                    {engagement.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>

  <div class="section--tight">
    <div class="section-head">
      <h2>{t(locale, 'resume.volunteer')}</h2>
    </div>
    <article class="timeline-item">
      <h3 class="timeline-role">{t(locale, 'resume.volunteerRole')}</h3>
      <p class="timeline-place">{t(locale, 'resume.volunteerBody')}</p>
    </article>
  </div>

  <aside class="cta-card">
    <div>
      <h2 class="timeline-role">{t(locale, 'resume.downloadTitle')}</h2>
      <p class="timeline-place">{t(locale, 'resume.downloadText')}</p>
    </div>
    <a class="btn btn-primary" href={resumePdf.href} download={resumePdf.download}>
      {t(locale, 'resume.downloadBtn')}
    </a>
  </aside>
</section>
