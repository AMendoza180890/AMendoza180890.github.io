---
/**
 * Root entry: detect preferred language from localStorage / browser,
 * then redirect to /en/ or /es/. Fully static-friendly.
 */
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Allan Mendoza | Portfolio</title>
    <meta
      name="description"
      content="Allan Mendoza — full-stack developer portfolio. Choose English or Spanish."
    />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="https://allanmendoza.tech/en/" />
    <link rel="icon" href="/favicon.ico" />
    <meta http-equiv="refresh" content="0;url=/en/" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('preferred-locale');
          var nav = (navigator.language || navigator.languages && navigator.languages[0] || 'en').toLowerCase();
          var locale = stored === 'es' || stored === 'en'
            ? stored
            : nav.startsWith('es')
              ? 'es'
              : 'en';
          localStorage.setItem('preferred-locale', locale);
          window.location.replace('/' + locale + '/');
        } catch (e) {
          window.location.replace('/en/');
        }
      })();
    </script>
  </head>
  <body>
    <p><a href="/en/">English</a> · <a href="/es/">Español</a></p>
  </body>
</html>
