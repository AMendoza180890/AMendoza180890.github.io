---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/ui';
import { site, skills } from '../../i18n/content';

const locale = 'es' as const;
---

<BaseLayout locale={locale} title={`${site.brand} | Portafolio`} activeNav="home">
  <section class="hero" id="top">
    <img
      class="hero-bg"
      src="/img/portfolio/background-mobile.webp"
      srcset="/img/portfolio/background-mobile.webp 480w, /img/portfolio/background-tablet.webp 1024w, /img/portfolio/background.webp 1920w"
      sizes="100vw"
      alt="Banner de fondo con código"
      width="480"
      height="360"
      fetchpriority="high"
      decoding="async"
    />
    <div class="container hero-content">
      <div class="hero-grid">
        <article>
          <h1 class="shadow-border">{site.name}</h1>
          <p class="typed-line">
            {t(locale, 'hero.imA')}
            <span class="typed" data-typed-items={t(locale, 'hero.typed')}></span>
          </p>
          <nav class="social-links" aria-label="Redes sociales">
            <a href={site.github} rel="noopener noreferrer" target="_blank" aria-label="GitHub">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.73.5.5 5.74.5 12.02c0 5.1 3.29 9.42 7.86 10.95.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.06-.73.08-.72.08-.72 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.76.41-1.27.74-1.56-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 2.9-.39c.98 0 1.97.13 2.9.39 2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.12 3.04.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.42.36.79 1.08.79 2.18 0 1.57-.01 2.84-.01 3.23 0 .31.21.68.8.56A10.53 10.53 0 0 0 23.5 12C23.5 5.74 18.27.5 12 .5Z"/></svg>
            </a>
            <a href={site.linkedin} rel="noopener noreferrer" target="_blank" aria-label="LinkedIn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5C4.98 4.88 3.86 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.24 8.25h4.52V24H.24V8.25zM8.34 8.25h4.33v2.14h.06c.6-1.14 2.08-2.34 4.28-2.34 4.58 0 5.42 3.01 5.42 6.93V24h-4.52v-7.75c0-1.85-.03-4.22-2.57-4.22-2.57 0-2.96 2.01-2.96 4.09V24H8.34V8.25z"/></svg>
            </a>
          </nav>
        </article>

        <article>
          <h2 class="resume-title shadow-border">{t(locale, 'skills.title')}</h2>
          <ul class="skills-list">
            {skills[locale].map((item) => (
              <li>
                <u>{item.label}:</u> {item.value}
              </li>
            ))}
          </ul>
        </article>

        <article class="hero-about">
          <h2 class="shadow-border">{t(locale, 'about.title')}</h2>
          <p class="about-text">{t(locale, 'about.body')}</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
