---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResumePage from '../../components/pages/ResumePage.astro';
import { t } from '../../i18n/ui';
import { site } from '../../i18n/content';

const locale = 'es' as const;
---

<BaseLayout
  locale={locale}
  title={`${t(locale, 'resume.pageTitle')} | ${site.name}`}
  description={t(locale, 'meta.resumeDescription')}
  activeNav="resume"
>
  <ResumePage locale={locale} />
</BaseLayout>
