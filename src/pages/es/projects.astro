---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectsPage from '../../components/pages/ProjectsPage.astro';
import { t } from '../../i18n/ui';
import { site } from '../../i18n/content';

const locale = 'es' as const;
---

<BaseLayout
  locale={locale}
  title={`${t(locale, 'projects.pageTitle')} | ${site.name}`}
  description={t(locale, 'meta.projectsDescription')}
  activeNav="projects"
>
  <ProjectsPage locale={locale} />
</BaseLayout>
