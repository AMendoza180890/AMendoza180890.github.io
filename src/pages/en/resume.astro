import ResumePage from '../../components/pages/ResumePage.astro';
import { t } from '../../i18n/ui';
import { site } from '../../i18n/content';

const locale = 'en' as const;
---

<BaseLayout locale={locale} title={`${site.brand} | ${t(locale, 'resume.pageTitle')}`} activeNav="resume">
  <ResumePage locale={locale} />
</BaseLayout>
